*.pyc
__pycache__/
*.egg-info/

.vscode/
.cursor/
.history/

# a leading underscore marks a file as work in progress, and keeps it out of git
_*
!__init__.py

# notes stay local; the top-level README is the only documentation that is tracked
*.md
!/README.md

# data, checkpoints and everything derived from them; the README explains the layout
data/**
!data/*/
!data/AlphaGenome/metadata.csv
!data/AlphaGenome/metadata_padded.tsv
!data/Borzoi/targets_human.txt
!data/Enformer/model_track_info.tsv
!data/Sei/Sei_tracks_info.csv
saved/
outputs/
results/
figures/
